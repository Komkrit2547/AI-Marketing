    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst posts = [];\nconst weather = [];\nconst businesses = [];\n\nfor (const item of items) {\n\n  // Facebook Post\n  if (item.json.contentPreview) {\n    posts.push({\n      groupName: item.json.groupName,\n      content: item.json.contentPreview\n        ?.replace(/\\n/g, ' ')\n        ?.substring(0, 150)\n    });\n  }\n\n  // Weather\n  else if (item.json.temperature) {\n    weather.push({\n      weather: item.json.weather,\n      temperature: item.json.temperature,\n      humidity: item.json.humidity\n    });\n  }\n\n  // Business\n  else if (item.json.category) {\n    businesses.push({\n      name: item.json.name,\n      category: item.json.category\n    });\n  }\n\n}\n\nreturn [{\n  json: {\n    posts: posts.slice(0, 10),\n    weather: weather.slice(0, 1),\n    businesses: businesses.slice(0, 15)\n  }\n}];"
      },
