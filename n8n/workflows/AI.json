    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst posts = [];\nconst weather = [];\nconst businesses = [];\n\nconst today = new Date();\ntoday.setHours(0, 0, 0, 0);\n\nfor (const item of items) {\n\n  // ===== Facebook Posts =====\n  if (item.json.contentPreview) {\n\n    const postDate = item.json.postedAt\n      ? new Date(item.json.postedAt)\n      : null;\n\n    const score =\n      (item.json.reactionCount || 0) * 1 +\n      (item.json.commentCount || 0) * 3 +\n      (item.json.shareCount || 0) * 5;\n\n    posts.push({\n      groupName: item.json.groupName,\n\n      content: item.json.contentPreview\n        ?.replace(/\\n/g, ' ')\n        ?.substring(0, 200),\n\n      reactionCount: item.json.reactionCount || 0,\n      commentCount: item.json.commentCount || 0,\n      shareCount: item.json.shareCount || 0,\n\n      engagementScore: score,\n\n      postedAt: item.json.postedAt\n    });\n  }\n\n  // ===== Weather =====\n  else if (item.json.temperature) {\n\n    weather.push({\n      weather: item.json.weather,\n      temperature: item.json.temperature,\n      humidity: item.json.humidity\n    });\n\n  }\n\n  // ===== Businesses =====\n  else if (item.json.category) {\n\n    businesses.push({\n      name: item.json.name,\n      category: item.json.category\n    });\n\n  }\n}\n\n// เรียงโพสต์จากคะแนนมากไปน้อย\nposts.sort(\n  (a, b) => b.engagementScore - a.engagementScore\n);\n\nreturn [{\n  json: {\n    posts: posts.slice(0, 10),\n    weather: weather.slice(0, 1),\n    businesses: businesses.slice(0, 15)\n  }\n}];"
      },
