        "jsCode": "let text = $json.output;\n\n// ลบ markdown code block\ntext = text\n  .replace(/^```json\\s*/i, '')\n  .replace(/\\s*```$/i, '')\n  .trim();\n\nconst data = JSON.parse(text);\n\nreturn data.insights.map((insight, index) => ({\n  json: {\n    title: insight.title || '',\n    summary: insight.summary || '',\n    recommendation: insight.recommendation || '',\n    category: insight.category || '',\n    priority: insight.priority || 'กลาง',\n    rank: index + 1\n  }\n}));"
