      "id": "36ea851d-8f65-4f23-9b73-0e4153ee79df",
      "name": "HTTP Request1"
    },
    {
      "parameters": {
        "jsCode": "const forecasts = $json.list;\n\nconst dailyForecasts = forecasts\n  .filter(item => item.dt_txt.includes('12:00:00'))\n  .slice(0, 5)\n  .map(item => ({\n    date: item.dt_txt.split(' ')[0],\n\n    district: 'Thap Sakae',\n    province: 'Prachuap Khiri Khan',\n\n    weather: item.weather?.[0]?.description ?? null,\n    weatherMain: item.weather?.[0]?.main ?? null,\n\n    temperature: item.main?.temp ?? null,\n    humidity: item.main?.humidity ?? null,\n    pressure: item.main?.pressure ?? null,\n\n    windSpeed: item.wind?.speed ?? null,\n\n    rainfall:\n      item.rain?.['3h'] ??\n      item.rain?.['1h'] ??\n      0,\n\n    source: 'OpenWeatherMap'\n  }));\n\nreturn dailyForecasts.map(item => ({ json: item }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        992,
        160
      ],
      "id": "414061b7-c0ef-48a2-aa50-2e05650494ca",
      "name": "Code in JavaScript1"
    },
    {
      "parameters": {
        "jsCode": "const current = $json.current;\n\nlet weather = 'อากาศโปร่ง';\n\nif (current.rain > 0) {\n  weather = 'กำลังมีฝน';\n} else if (current.cloud_cover > 70) {\n  weather = 'เมฆมาก';\n} else if (current.cloud_cover > 30) {\n  weather = 'เมฆบางส่วน';\n}\n\nreturn [{\n  json: {\n    district: 'ทับสะแก',\n    province: 'ประจวบคีรีขันธ์',\n\n    weather,\n\n    temperature: current.temperature_2m,\n    humidity: current.relative_humidity_2m,\n\n    rainfall: current.rain,\n\n    windSpeed: current.wind_speed_10m,\n\n    source: 'open-meteo',\n\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -304,
        592
      ],
      "id": "30ecf345-f4ae-46d6-b228-a8f4b959b0a7",
      "name": "Code in JavaScript2"
    },
    {
      "parameters": {
        "rule": {
          "interval": [
