      ],
      "id": "76cbd27a-e535-4760-9a7b-55811883f9b6",
      "name": "Schedule Trigger1"
    },
    {
      "parameters": {
        "jsCode": "const daily = $json.daily;\n\nconst thaiDays = [\n  'วันอาทิตย์',\n  'วันจันทร์',\n  'วันอังคาร',\n  'วันพุธ',\n  'วันพฤหัสบดี',\n  'วันศุกร์',\n  'วันเสาร์'\n];\n\nreturn daily.time.map((date, index) => {\n\n  const dayName = thaiDays[new Date(date).getDay()];\n\n  let weather = 'อากาศโปร่ง';\n\n  if (daily.precipitation_sum[index] >= 20) {\n    weather = 'ฝนตกหนัก';\n  } else if (daily.precipitation_sum[index] >= 5) {\n    weather = 'มีฝน';\n  } else if (daily.precipitation_sum[index] > 0) {\n    weather = 'ฝนเล็กน้อย';\n  }\n\n  return {\n    json: {\n      district: 'ทับสะแก',\n      province: 'ประจวบคีรีขันธ์',\n\n      forecastDate: new Date(date).toISOString(),\n\n      dayName,\n\n      weather,\n\n      maxTemp: daily.temperature_2m_max[index],\n      minTemp: daily.temperature_2m_min[index],\n\n      rainfall: daily.precipitation_sum[index],\n\n      source: 'open-meteo'\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
