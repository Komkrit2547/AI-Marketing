generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model News {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  content     String?
  source      String
  url         String?
  category    String?
  publishedAt DateTime?
  createdAt   DateTime @default(now())
}

model AIInsight {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  summary         String
  recommendation  String?
  category        String?
  relatedNewsId   String?  @db.ObjectId
  createdAt       DateTime @default(now())
}

model Campaign {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  caption     String?
  couponText  String?
  status      String   @default("draft")
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
